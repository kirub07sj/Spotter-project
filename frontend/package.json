{
  "name": "spotter-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript openapi.yaml -o src/api/schema.d.ts && prettier --write src/api/schema.d.ts",
    "size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.1",
    "@deck.gl/extensions": "9.4.1",
    "@deck.gl/layers": "^9.4.1",
    "@deck.gl/mapbox": "^9.4.1",
    "@hookform/resolvers": "^7.0.7",
    "@mapbox/polyline": "^1.2.1",
    "@tanstack/react-query": "^5.108.1",
    "maplibre-gl": "^5.24.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-map-gl": "^8.1.3",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/mapbox__polyline": "^1.0.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "autoprefixer": "^10.7.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.33",
    "prettier": "^3.10.1",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
