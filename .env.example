# Copy to .env and fill in. Never commit .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# real | fake. fake runs the whole app offline with deterministic routes and weather.
PROVIDERS=real
MAPBOX_TOKEN=
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_API_KEY=            # only for commercial plans
REDIS_URL=                     # optional, LocMemCache when empty
RISK_WIND_METRIC=gust          # gust | sustained (D-04)
TRUCK_MAX_SPEED_MPH=65         # 0 disables (D-07)
HEATMAP_CORRIDOR_KM=40         # D-16
HEATMAP_MAX_POINTS=450
MAPBOX_USE_MAX_WEIGHT=false    # pass gross weight to Mapbox max_weight
TRACTOR_TRAILER_TARE_LB=35000  # used only when MAPBOX_USE_MAX_WEIGHT=true
LOG_LEVEL=INFO
GIT_SHA=                       # optional; also read from RENDER_GIT_COMMIT / RAILWAY_GIT_COMMIT_SHA, else `git rev-parse`
DJANGO_SECURE_SSL_REDIRECT=true # prod only; set false to run prod settings locally over http

# Frontend (Vite reads these at build time; put them in frontend/.env.local or the host's env)
VITE_API_BASE_URL=/api/v1
VITE_MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/positron-gl-style/style.json
